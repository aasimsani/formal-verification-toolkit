#!/usr/bin/env python3
"""Run TLC on each config and compare the outcome with the config's expect header.

Usage: fv-tlc [--trace] <Spec.tla> [<Config.cfg> ...]

With no config, every .cfg file beside the spec runs. Each config declares the
outcome it must produce on a comment line:

  \\* expect: holds                  TLC finds no error
  \\* expect: violated <Invariant>   TLC reports that this invariant is violated
  \\* expect: liveness               TLC reports a violated temporal property
  \\* expect: deadlock               TLC reports a deadlock

The script prints one line per config:

  PASS <cfg>: <outcome> (<n> distinct states)
  FAIL <cfg>: expected <header>, got <outcome>
  ERROR <cfg>: <reason>              TLC could not check the spec

A FAIL on a violation is followed by the counterexample, reduced to the
variables each step changed. --trace prints that reduction for every violation,
including the ones a header expects.

Exit codes: 0 when every config passes, 1 on a FAIL or an ERROR, 2 on a usage
error, and 3 when Java or the TLC jar is missing. Exit 3 means the spec was not
checked, so never report it as a pass or as a failure of the model.

Environment: FV_HOME (default ~/.cache/fv), JAVA (default java),
FV_TLC_WORKERS (default 1).
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# TLC 1.7.4 exit codes, measured on the fixtures in tests/fixtures/tla.
EXIT_HOLDS, EXIT_DEADLOCK, EXIT_SAFETY, EXIT_LIVENESS = 0, 11, 12, 13

CFG_KEYWORDS = {
    "SPECIFICATION", "INIT", "NEXT", "CONSTANT", "CONSTANTS", "INVARIANT",
    "INVARIANTS", "PROPERTY", "PROPERTIES", "CONSTRAINT", "CONSTRAINTS",
    "ACTION_CONSTRAINT", "ACTION_CONSTRAINTS", "SYMMETRY", "VIEW",
    "CHECK_DEADLOCK", "ALIAS", "POSTCONDITION",
}


def expect_header(cfg_text):
    """Return the text after 'expect:' on the first header line, or None."""
    match = re.search(r"^\s*\\\*\s*expect:\s*(.+?)\s*$", cfg_text, re.MULTILINE)
    return match.group(1) if match else None


def temporal_properties(cfg_text):
    """List the names under PROPERTY and PROPERTIES.

    TLC does not say which temporal property failed, so the FAIL line names
    every candidate.
    """
    names, collecting = [], False
    for line in cfg_text.splitlines():
        for token in line.split("\\*")[0].split():
            if token in CFG_KEYWORDS:
                collecting = token in ("PROPERTY", "PROPERTIES")
            elif collecting:
                names.append(token)
    return names


def outcome_of(returncode, output, cfg_text):
    """Map a TLC run to an outcome string, or to None when TLC failed to check."""
    if returncode == EXIT_HOLDS:
        return "holds"
    if returncode == EXIT_DEADLOCK:
        return "deadlock"
    if returncode == EXIT_SAFETY:
        match = re.search(r"Invariant (\S+) is violated", output)
        return f"violated {match.group(1)}" if match else "violated an action property"
    if returncode == EXIT_LIVENESS:
        names = ", ".join(temporal_properties(cfg_text)) or "unknown"
        return f"liveness (properties: {names})"
    return None


def matches(expected, outcome):
    if expected == "liveness":
        return outcome.startswith("liveness")
    return expected == outcome


def reduced_trace(output):
    """Reduce a TLC counterexample to the variables each step changed."""
    states, label, values, name = [], None, {}, None
    for line in output.splitlines():
        header = re.match(r"^State (\d+): (.*)$", line)
        if header:
            if label is not None:
                states.append((label, values))
            action = re.match(r"<(\w+)", header.group(2))
            label, values, name = (action.group(1) if action else header.group(2)), {}, None
            continue
        if label is None:
            continue
        # TLC omits the leading conjunction when the spec has one variable.
        assignment = re.match(r"^(?:/\\ )?(\w+) = (.*)$", line)
        if assignment:
            name = assignment.group(1)
            values[name] = assignment.group(2)
        elif line.strip() and name and not line.startswith(("Error", "Back to", "Finished", "The ")):
            values[name] += " " + line.strip()
        elif not line.strip():
            name = None
    if label is not None:
        states.append((label, values))

    lines, previous = [], {}
    for number, (label, values) in enumerate(states, start=1):
        if not previous:
            changes = ", ".join(f"{k} = {v}" for k, v in values.items())
        else:
            changes = ", ".join(
                f"{k}: {previous.get(k)} -> {v}" for k, v in values.items() if previous.get(k) != v
            )
        lines.append(f"  {number}. {label}: {changes or 'no variable changed'}")
        previous = {**previous, **values}
    back = re.search(r"^Back to state (\d+)", output, re.MULTILINE)
    if back:
        lines.append(f"  The behaviour then returns to state {back.group(1)} and repeats.")
    return lines


def main(argv):
    args = [a for a in argv if a != "--trace"]
    show_all_traces = len(args) != len(argv)
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if args else 2
    spec = Path(args[0]).resolve()
    if not spec.is_file():
        print(f"usage: fv-tlc [--trace] <Spec.tla> [<Config.cfg> ...]\n{spec} is not a file", file=sys.stderr)
        return 2
    configs = [Path(a).resolve() for a in args[1:]] or sorted(spec.parent.glob("*.cfg"))
    if not configs:
        print(f"usage: no .cfg file beside {spec.name}", file=sys.stderr)
        return 2

    java = os.environ.get("JAVA", "java")
    jar = Path(os.environ.get("FV_HOME", Path.home() / ".cache" / "fv")) / "tla2tools.jar"
    if not jar.is_file():
        print(f"UNAVAILABLE tla: {jar} is missing; run fv-install tla")
        return 3
    if not shutil.which(java):
        print(f"UNAVAILABLE java: {java} is not on PATH; install a JDK 17 or later or set JAVA")
        return 3

    failed = False
    for cfg in configs:
        if not cfg.is_file():
            print(f"ERROR {cfg.name}: the config file does not exist")
            failed = True
            continue
        cfg_text = cfg.read_text()
        expected = expect_header(cfg_text)
        if expected is None:
            print(f"FAIL {cfg.name}: no expect header")
            failed = True
            continue
        with tempfile.TemporaryDirectory(prefix="fv-tlc-") as metadir:
            run = subprocess.run(
                [java, "-XX:+UseParallelGC", "-cp", str(jar), "tlc2.TLC",
                 "-workers", os.environ.get("FV_TLC_WORKERS", "1"),
                 "-metadir", metadir, "-config", str(cfg), str(spec)],
                cwd=spec.parent, capture_output=True, text=True,
            )
        output = run.stdout + run.stderr
        outcome = outcome_of(run.returncode, output, cfg_text)
        if outcome is None:
            print(f"ERROR {cfg.name}: TLC exited {run.returncode} without a verdict")
            print("\n".join("  " + line for line in output.strip().splitlines()[-6:]))
            failed = True
            continue
        violated = outcome != "holds"
        if matches(expected, outcome):
            found = re.findall(r"(\d+) distinct states found", output)
            print(f"PASS {cfg.name}: {outcome} ({found[-1] if found else '?'} distinct states)")
            if violated and show_all_traces:
                print("\n".join(reduced_trace(output)))
        else:
            print(f"FAIL {cfg.name}: expected {expected}, got {outcome}")
            if violated:
                print("\n".join(reduced_trace(output)))
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
